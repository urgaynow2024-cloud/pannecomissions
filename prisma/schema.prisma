generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PortfolioItem {
  id              String    @id @default(cuid())
  display_title   String?
  category        String?
  description     String?
  alt_text        String?
  image_url       String
  sort_order      Int       @default(0)
  featured        Boolean   @default(false)
  nsfw            Boolean   @default(false)
  visible         Boolean   @default(true)
  homepage_visible Boolean  @default(true)
  focal_point_x   Float?    @default(0.5)
  focal_point_y   Float?    @default(0.5)
  deleted_at      DateTime?
  created_at      DateTime  @default(now()) @map("created_at")
  updated_at      DateTime  @updatedAt @map("updated_at")

  photos Photo[]

  @@map("portfolio_items")
}

model Review {
  id             String    @id @default(cuid())
  display_name   String    @map("display_name")
  rating         Int
  review_text    String    @map("review_text")
  image_url      String?
  status         String    @default("PENDING")
  hidden         Boolean   @default(false)
  rejection_reason String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  photos Photo[]

  @@map("reviews")
}

model CommissionSubmission {
  id             String    @id @default(cuid())
  client_name    String
  email          String
  service        String
  description    String?
  additional     String?
  status         String    @default("PENDING")
  nsfw           Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("commission_submissions")
}

model SupportRequest {
  id          String    @id @default(cuid())
  client_name String
  email       String
  subject     String
  message     String
  status      String    @default("PENDING")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("support_requests")
}

model SiteSetting {
  id               String    @id @default(cuid())
  key              String    @unique
  value            String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("site_settings")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  password_hash String
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  sessions Session[]

  @@map("admin_users")
}

model Session {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ContactSubmission {
  id         String    @id @default(cuid())
  name       String
  email      String
  message    String
  created_at DateTime  @default(now())

  @@map("contact_submissions")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  image_url   String?
  sort_order  Int       @default(0)
  visible     Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  photos Photo[]

  @@map("services")
}

model Photo {
  id               String    @id @default(cuid())
  url              String
  alt_text         String?
  width            Int?
  height           Int?
  file_size        Int?
  mime_type        String?
  sort_order       Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  portfolioItemId  String?   @map("portfolio_item_id")
  portfolioItem    PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  serviceId        String?   @map("service_id")
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  reviewId         String?   @map("review_id")
  review           Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Pricing {
  id          String    @id @default(cuid())
  name        String
  min_price   Float?
  max_price   Float?
  description String?
  visible     Boolean   @default(true)
  sort_order  Int       @default(0)
  category    String    @default("sfw")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("pricing")
}
