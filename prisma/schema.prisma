generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PortfolioItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  alt_text    String?
  image_url   String
  sort_order  Int       @default(0)
  featured    Boolean   @default(false)
  nsfw        Boolean   @default(false)
  visible     Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("portfolio_items")
}

model Review {
  id               String    @id @default(cuid())
  client_name      String
  rating           Int
  message          String
  status           String    @default("PENDING")
  rejection_reason String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("reviews")
}

model CommissionSubmission {
  id             String    @id @default(cuid())
  client_name    String
  email          String
  service        String
  description    String?
  additional     String?
  status         String    @default("PENDING")
  nsfw           Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("commission_submissions")
}

model SupportRequest {
  id          String    @id @default(cuid())
  client_name String
  email       String
  subject     String
  message     String
  status      String    @default("PENDING")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("support_requests")
}

model SiteSetting {
  id         String    @id @default(cuid())
  key        String    @unique
  value      String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("site_settings")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  password_hash String
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  sessions Session[]

  @@map("admin_users")
}

model Session {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ContactSubmission {
  id         String    @id @default(cuid())
  name       String
  email      String
  message    String
  created_at DateTime  @default(now())

  @@map("contact_submissions")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  image_url   String?
  sort_order  Int       @default(0)
  visible     Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("services")
}

model Pricing {
  id          String    @id @default(cuid())
  name        String
  min_price   Float?
  max_price   Float?
  description String?
  visible     Boolean   @default(true)
  sort_order  Int       @default(0)
  category    String    @default("sfw")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("pricing")
}
