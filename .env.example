# For Vercel / serverless: use pooled connection with connection_limit=1
DATABASE_URL=postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=0

# For local dev: direct connection (no pgBouncer)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?sslmode=require

SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-secure-admin-password
DISCORD_WEBHOOK_URL=your-discord-webhook-url
NEXT_PUBLIC_SITE_URL=https://pannecomissions.shop
